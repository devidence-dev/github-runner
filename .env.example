# Environment variables for the GitHub Actions Runner
# Copy this file to .env and fill in your real values

# GitHub Configuration
GH_OWNER=your-organization-or-username      # 👈 Your organization or username
GH_TOKEN=github_pat_11XXXXX...              # 👈 The token you just created
RUNNER_NAME=devidence-homelab-runner        # 👈 A name for your runner
RUNNER_GROUP=devidence-home-server          # 👈 Runner group name (optional, default: Default)
RUNNER_LABELS=privileged,homelab            # 👈 Labels required by workflows that need host access

# Telegram Bot Configuration (for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Runner Configuration
RUNNER_DATA=your_runner_data_path_here      # 👈 Path to store runner data
HOST_REPOS_PATH=your_local_repos_path_here  # 👈 Path to your local repositories

RUNNER_VERSION=2.335.1                      # 👈 The version of the GitHub Actions Runner to use
SONAR_SCANNER_VERSION=7.3.0.5189            # 👈 The version of SonarScanner CLI to use

# Optional: Path to extra images configuration file (if you have additional Docker images to pull)
EXTRA_IMAGES_FILE=./extra-images.yml                 # 👈 Path to extra images configuration file (optional)
# Optional: Manual registration token (if you have trouble with automatic generation)
# Get one by running: curl -X POST -H "Authorization: token YOUR_TOKEN" https://api.github.com/repos/OWNER/REPO/actions/runners/registration-token
# REGISTRATION_TOKEN=your_manual_registration_token
